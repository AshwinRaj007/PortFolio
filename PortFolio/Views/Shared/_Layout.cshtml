<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        accent: '#FF6B2B'
                    }
                }
            }
        }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
        body {
            margin: 0;
            background: #09090b;
            color: white;
            font-family: 'DM Sans',sans-serif;
        }

        h1, h2, h3 {
            font-family: 'PT Sans',sans-serif;
        }
    </style>
</head>
<body class="bg-zinc-950 text-white">
    @RenderBody()
</body>
</html>